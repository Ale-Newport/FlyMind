# Copy to .env (never commit .env). All variables are optional.
# Where datasets live (default: <repo>/data)
FLYMIND_DATA_DIR=
# Where experiment results are written (default: <repo>/experiments)
FLYMIND_EXPERIMENTS_DIR=
# Comma-separated browser origins allowed by CORS
FLYMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Logging
FLYMIND_LOG_LEVEL=INFO
FLYMIND_LOG_JSON=1
# Web dev server: API to proxy to, and optional direct WebSocket origin
FLYMIND_API=http://127.0.0.1:8000
VITE_WS_ORIGIN=
# Headless Linux rendering for compound-eye vision (egl or osmesa)
MUJOCO_GL=
